# Kopiere diese Datei zu ".env" und passe sie an, bevor du "docker compose up" startest.

# Geheimer Schluessel zum Signieren der Login-Tokens - unbedingt aendern!
JWT_SECRET=change-me-to-a-long-random-string

# Erlaubte Frontend-Origin fuer die API (in Produktion einschraenken statt "*")
CORS_ORIGIN=*

# Nur fuer die Anzeige der RTMP-URL im Dashboard: deine Server-IP oder Domain
PUBLIC_HOST=localhost

# Anzahl Chatnachrichten, die beim Betreten eines Kanals als Verlauf geladen werden
CHAT_HISTORY_LIMIT=50

# Nur setzen, wenn API/Media-Server auf einem ANDEREN Host als das Frontend laufen
# (z.B. eigene Domain/Reverse-Proxy). Standardmaessig leer lassen - dann wird die
# URL automatisch aus dem Hostnamen der Seite abgeleitet (funktioniert fuer
# localhost, LAN-IP und die meisten Docker-Setups ohne Anpassung).
# VITE_API_URL=https://stream.example.com:4000
# VITE_MEDIA_URL=https://stream.example.com:8000
