# Kopiere diese Datei zu ".env" und passe sie an, bevor du "docker compose up" startest.

# PFLICHT: Geheimer Schluessel zum Signieren der Login-Tokens.
# Erzeugen mit:  openssl rand -hex 32
# Ohne eigenen Wert startet der Server im Produktivbetrieb bewusst nicht.
JWT_SECRET=

# Deine Domain - nur fuer den Produktivbetrieb mit HTTPS noetig
# (docker-compose.prod.yml). Ein A-Record muss auf die Server-IP zeigen.
DOMAIN=stream.example.com

# Wird im Dashboard als RTMP-Serveradresse angezeigt. Produktiv auf die
# eigene Domain bzw. Server-IP setzen, damit OBS die richtige Adresse bekommt.
PUBLIC_HOST=localhost

# Port der Web-App im lokalen Setup (ohne HTTPS-Override)
WEB_PORT=5173

# Anzahl Chatnachrichten, die beim Betreten eines Kanals als Verlauf geladen werden
CHAT_HISTORY_LIMIT=50

# Normalerweise leer lassen! API, Chat und HLS laufen ueber denselben Origin,
# der Reverse Proxy verteilt sie intern. Nur setzen, wenn Backend/Medien
# bewusst auf einer ANDEREN Domain betrieben werden.
# VITE_API_URL=
# VITE_MEDIA_URL=
