# Server / API
NODE_ENV=development
API_PORT=4000

# RTMP + HLS Media-Server
RTMP_PORT=1935
MEDIA_HTTP_PORT=8000
# Pfad zur ffmpeg-Binary (wird fuer die RTMP -> HLS Umwandlung benoetigt)
FFMPEG_PATH=/usr/bin/ffmpeg

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# CORS - Origin des Frontends (in Produktion einschraenken statt "*")
CORS_ORIGIN=*

# Nur fuer die Anzeige der RTMP-URL im Dashboard (deine Server-IP oder Domain)
PUBLIC_HOST=localhost

# Anzahl Chatnachrichten, die beim Betreten eines Kanals als Verlauf geladen werden
CHAT_HISTORY_LIMIT=50
