# Optional: nur setzen, wenn API/Media-Server NICHT auf dem gleichen Host wie
# das Frontend erreichbar sind (z.B. eigene Domain/Reverse-Proxy-Setup).
# Standardmaessig wird die URL automatisch aus dem Hostnamen der Seite abgeleitet
# (Host:4000 fuer die API, Host:8000 fuer HLS) - fuer LAN/Docker reicht das ohne Anpassung.
# VITE_API_URL=https://stream.example.com:4000
# VITE_MEDIA_URL=https://stream.example.com:8000
